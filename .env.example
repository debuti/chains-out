# Telegram (crea el bot con @BotFather; el chat_id sale de `chainsout telegram-setup`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Clasificador: claude_cli (suscripción, por defecto) | anthropic_api (requiere ANTHROPIC_API_KEY y `uv sync --extra api`)
LLM_BACKEND=claude_cli
# Modelo: claude-opus-5-5 (por defecto) o claude-haiku-5-5 para gastar menos cuota
LLM_MODEL=claude-opus-5-5
# Ruta del CLI de Claude Code
CLAUDE_BIN=/usr/local/bin/claude
# Segundos máximos por llamada al clasificador
LLM_TIMEOUT=300
# Ofertas por llamada al LLM
CLASSIFY_BATCH=5
# Nota mínima (0-10) para notificar un "maybe"
UMBRAL_MAYBE=6
# ANTHROPIC_API_KEY=

# Base de datos SQLite
CHAINSOUT_DB=chainsout.db
